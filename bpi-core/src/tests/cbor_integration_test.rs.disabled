2
//! 
//! Tests government enterprise-grade CBOR serialization, audit trails,
//! compliance metadata, and impossible-to-hide actionable events.

use anyhow::Result;
use chrono::{DateTime, Utc};
use serde_json;
use std::collections::BTreeMap;

use crate::cbor_pipeline_foundation::*;
