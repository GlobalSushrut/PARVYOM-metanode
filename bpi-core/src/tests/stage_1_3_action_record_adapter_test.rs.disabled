/// Run all Stage 1.3 Action Record Adapter tests
pub async fn run_stage_1_3_tests() -> Result<()> {
    println!("🚀 Running Stage 1.3 Action Record Adapter CBOR Integration Tests...");
    
    test_action_record_adapter_creation_and_cbor()?;
    test_audit_record_conversion_with_impossible_to_hide_events()?;
    test_government_compliance_and_retention()?;
    test_multiple_conversions_and_performance_metrics()?;
    test_vm_type_mapping_and_component_conversion()?;
    test_cbor_diagnostic_universal_auditability()?;
    
    println!("🎉 All Stage 1.3 Action Record Adapter tests PASSED!");
    Ok(())
}
