            audit_entries: vec![],
            compliance_score: 1.0,
            created_at: Utc::now(),
            entry_id: "test_audit_001".to_string(),
            government_compliance: GovernmentComplianceAudit {
                audit_reference: "test_ref_001".to_string(),
