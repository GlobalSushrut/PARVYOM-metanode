# BPCI Enterprise - Environment Configuration
# Copy this file to .env.local for local development
# Copy this file to .env.production for production deployment

# =============================================================================
# API Configuration - Cloud Ready
# =============================================================================

# Production API (DigitalOcean Instance 4)
REACT_APP_API_URL=http://146.190.74.139:8080

# Local Development API
# REACT_APP_API_URL=http://localhost:8080

# =============================================================================
# Component Endpoints (for direct component access if needed)
# =============================================================================

# Component 1: Consensus Server
REACT_APP_CONSENSUS_URL=http://159.203.101.136:9001

# Component 2: Blockchain Server
REACT_APP_BLOCKCHAIN_URL=http://159.203.101.136:8080

# Component 3: Auction Mempool
REACT_APP_AUCTION_URL=http://159.203.101.136:7002

# Component 4: BSO-K8 Orchestrator
REACT_APP_ORCHESTRATOR_URL=http://159.203.101.136:9090

# Component 5: BPI-BPCI Bridge
REACT_APP_BRIDGE_URL=http://159.203.101.136:6001

# Component 6: Cluster Ledger Server (CRITICAL - handles millions of BPI instances)
REACT_APP_CLUSTER_LEDGER_URL=http://159.203.101.136:7000

# Component 7: XTMP Server
REACT_APP_XTMP_URL=http://159.203.101.136:8889

# Component 8: Shadow Registry
REACT_APP_SHADOW_REGISTRY_URL=http://159.203.101.136:8081

# Component 9: Web Interface (same as API_URL)
REACT_APP_WEB_URL=http://146.190.74.139:8080

# =============================================================================
# Keycloak Configuration
# =============================================================================

REACT_APP_KEYCLOAK_URL=http://localhost:8080
REACT_APP_KEYCLOAK_REALM=bpci-enterprise
REACT_APP_KEYCLOAK_CLIENT_ID=bpci-web-client

# =============================================================================
# Feature Flags
# =============================================================================

# Enable real backend integration (disable for mock mode)
REACT_APP_USE_REAL_BACKEND=true

# Enable 4-coin balance display (GEN/NEX/FLX/AUR)
REACT_APP_SHOW_4_COIN_BALANCE=true

# Enable Component 6 direct queries (for advanced features)
REACT_APP_ENABLE_CLUSTER_LEDGER_QUERIES=true

# Enable debug logging
REACT_APP_DEBUG_MODE=false

# =============================================================================
# Network Configuration
# =============================================================================

# Network type (mainnet, testnet, devnet)
REACT_APP_NETWORK=mainnet

# Enable P2P mesh networking
REACT_APP_ENABLE_P2P_MESH=true

# =============================================================================
# Security Configuration
# =============================================================================

# Enable token+address validation
REACT_APP_VALIDATE_TOKEN_ADDRESS=true

# Session timeout (in minutes)
REACT_APP_SESSION_TIMEOUT=30

# Enable auto-logout on inactivity
REACT_APP_AUTO_LOGOUT=true
