# BPCI Enterprise - Production Environment Configuration
# Integrated with Keycloak-Cloudflare SSO Pipeline

# =============================================================================
# API Configuration - Production Ready
# =============================================================================

# Production API (BPCI Enterprise Cloud Instance)
REACT_APP_API_URL=https://api.pravyom.com

# BPCI Infrastructure Endpoints (Production)
REACT_APP_CONSENSUS_URL=https://consensus.pravyom.com
REACT_APP_BLOCKCHAIN_URL=https://blockchain.pravyom.com
REACT_APP_AUCTION_URL=https://auction.pravyom.com
REACT_APP_ORCHESTRATOR_URL=https://orchestrator.pravyom.com
REACT_APP_BRIDGE_URL=https://bridge.pravyom.com
REACT_APP_CLUSTER_LEDGER_URL=https://cluster.pravyom.com
REACT_APP_XTMP_URL=https://xtmp.pravyom.com
REACT_APP_SHADOW_REGISTRY_URL=https://registry.pravyom.com
REACT_APP_WEB_URL=https://api.pravyom.com

# =============================================================================
# Keycloak-Cloudflare SSO Configuration (Production)
# =============================================================================

# Keycloak Authentication Service (Deployed via Cloudflare)
REACT_APP_KEYCLOAK_URL=https://auth.pravyom.com
REACT_APP_KEYCLOAK_REALM=pravyom-blockchain
REACT_APP_KEYCLOAK_CLIENT_ID=bpci-web-client

# Authentication Endpoints
REACT_APP_AUTH_LOGIN_URL=https://auth.pravyom.com/auth/login
REACT_APP_AUTH_SIGNUP_URL=https://auth.pravyom.com/auth/register
REACT_APP_AUTH_TOKEN_URL=https://auth.pravyom.com/auth/token
REACT_APP_AUTH_USERINFO_URL=https://auth.pravyom.com/auth/userinfo
REACT_APP_AUTH_LOGOUT_URL=https://auth.pravyom.com/auth/logout

# =============================================================================
# BPI Integration Configuration
# =============================================================================

# BPI Explorer Integration
REACT_APP_EXPLORER_URL=https://explorer.pravyom.com

# BPI Node Connection
REACT_APP_BPI_CONNECTION_URL=https://connect.pravyom.com

# Complex Address Resolution
REACT_APP_ADDRESS_RESOLVER_URL=https://resolver.pravyom.com

# =============================================================================
# Security & Performance Configuration
# =============================================================================

# Enable production optimizations
REACT_APP_ENVIRONMENT=production

# Security headers and CORS
REACT_APP_ENABLE_SECURITY_HEADERS=true
REACT_APP_ENABLE_CORS=true

# Performance monitoring
REACT_APP_ENABLE_TELEMETRY=true
REACT_APP_ENABLE_REQUEST_TRACKING=true

# =============================================================================
# Feature Flags
# =============================================================================

# Authentication features
REACT_APP_ENABLE_KEYCLOAK_SSO=true
REACT_APP_ENABLE_EMAIL_VERIFICATION=true
REACT_APP_ENABLE_OTP_VERIFICATION=true
REACT_APP_ENABLE_WALLET_ACTIVATION=true

# BPI features
REACT_APP_ENABLE_BPI_INTEGRATION=true
REACT_APP_ENABLE_COMPLEX_ADDRESSING=true
REACT_APP_ENABLE_MILLIONS_SCALE_ONBOARDING=true

# Developer features (disabled in production)
REACT_APP_ENABLE_DEV_BYPASS=false
REACT_APP_ENABLE_DEBUG_MODE=false

# =============================================================================
# Wallet & Payment Configuration
# =============================================================================

# Stripe integration (if needed)
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder

# Wallet configuration
REACT_APP_DEFAULT_NETWORK=testnet
REACT_APP_ENABLE_MAINNET=false

# =============================================================================
# Email & Notification Configuration
# =============================================================================

# Email service configuration
REACT_APP_EMAIL_SERVICE_URL=https://api.pravyom.com/email
REACT_APP_ENABLE_EMAIL_NOTIFICATIONS=true

# Notification settings
REACT_APP_ENABLE_PUSH_NOTIFICATIONS=false
REACT_APP_ENABLE_SMS_NOTIFICATIONS=false
