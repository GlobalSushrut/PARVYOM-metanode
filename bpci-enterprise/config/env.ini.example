# BPCI Enterprise - Advanced Environment Configuration
# This file uses the revolutionary env.ini format with vPod virtual environments
# Parsed by: src/config/env_ini_parser.rs
# Lock file: envtoml.lock (auto-generated, like Cargo.lock)

# =============================================================================
# Global Variables (No Section)
# =============================================================================
ENVIRONMENT=production
LOG_LEVEL=info
RUST_BACKTRACE=1

# =============================================================================
# [component_1_consensus] - BPCI Consensus Server (Port 9001)
# =============================================================================
[component_1_consensus]
enabled=true
port=9001
host=0.0.0.0
endpoint=http://159.203.101.136:9001
vpod_count=10
memory_mb=512
cpu_cores=1.0

# =============================================================================
# [component_2_blockchain] - BPCI Blockchain Server (Port 8080)
# =============================================================================
[component_2_blockchain]
enabled=true
port=8080
host=0.0.0.0
endpoint=http://159.203.101.136:8080
vpod_count=20
memory_mb=1024
cpu_cores=2.0
tps_target=1250
block_time_seconds=2

# =============================================================================
# [component_3_auction] - BPCI Auction Mempool (Port 7002)
# =============================================================================
[component_3_auction]
enabled=true
port=7002
host=0.0.0.0
endpoint=http://159.203.101.136:7002
vpod_count=15
memory_mb=768
cpu_cores=1.5

# =============================================================================
# [component_4_bso_k8] - BSO-K8 Orchestrator (Port 9090)
# =============================================================================
[component_4_bso_k8]
enabled=true
port=9090
host=0.0.0.0
endpoint=http://159.203.101.136:9090
orchestrator_id=bpci-production-orchestrator
enable_cellular=true
vpod_count=50
memory_mb=2048
cpu_cores=4.0

# =============================================================================
# [component_5_bridge] - BPI-BPCI Bridge (Port 6001)
# =============================================================================
[component_5_bridge]
enabled=true
port=6001
host=0.0.0.0
endpoint=http://159.203.101.136:6001
consensus_endpoint=http://159.203.101.136:9001
blockchain_endpoint=http://159.203.101.136:8080
auction_endpoint=http://159.203.101.136:7002
vpod_count=25
memory_mb=1024
cpu_cores=2.0

# =============================================================================
# [component_6_cluster_ledger] - Cluster Ledger Server (Port 7000) **CRITICAL**
# =============================================================================
[component_6_cluster_ledger]
enabled=true
port=7000
host=0.0.0.0
endpoint=http://159.203.101.136:7000
# Handles millions of BPI OS instances
max_bpi_connections=10000000
vpod_clusters=1000
vpods_per_cluster=100
memory_mb=4096
cpu_cores=8.0
enable_websocket=true
enable_token_validation=true

# =============================================================================
# [component_7_xtmp] - XTMP Server (Port 8889)
# =============================================================================
[component_7_xtmp]
enabled=true
port=8889
host=0.0.0.0
endpoint=http://159.203.101.136:8889
vpod_count=10
memory_mb=512
cpu_cores=1.0

# =============================================================================
# [component_8_shadow_registry] - Shadow Registry (Port 8081)
# =============================================================================
[component_8_shadow_registry]
enabled=true
port=8081
host=0.0.0.0
endpoint=http://159.203.101.136:8081
vpod_count=10
memory_mb=512
cpu_cores=1.0

# =============================================================================
# [component_9_web] - Web Interface (Port 8080 - shared with blockchain)
# =============================================================================
[component_9_web]
enabled=true
port=8080
host=0.0.0.0
endpoint=http://146.190.74.139:8080
cluster_ledger_url=http://159.203.101.136:7000
enable_real_backend=true
show_4_coin_balance=true
vpod_count=15
memory_mb=768
cpu_cores=1.5

# =============================================================================
# [vpod_environment] - vPod Virtual Environment Configuration
# =============================================================================
[vpod_environment]
vpod_id=bpci-production-vpod-env
arena_size_mb=8192
max_vpods=200
isolation_level=Full
memory_limit_mb=16384
cpu_limit_cores=16.0
disk_limit_mb=102400
network_bandwidth_mbps=1000

# =============================================================================
# [bso_k8_deployment] - BSO-K8 Deployment Configuration
# =============================================================================
[bso_k8_deployment]
orchestrator_id=bpci-production-orchestrator
deployment_strategy=RollingUpdate
replicas=3
health_check_enabled=true
health_check_endpoint=/health
health_check_interval_seconds=30
health_check_timeout_seconds=5
health_check_retries=3

# =============================================================================
# [database] - Database Configuration
# =============================================================================
[database]
type=postgresql
host=localhost
port=5432
database=bpci_enterprise
username=bpci_admin
# password stored in secrets vault
max_connections=100
pool_size=20

# =============================================================================
# [keycloak] - Keycloak SSO Configuration
# =============================================================================
[keycloak]
url=http://localhost:8080
realm=bpci-enterprise
client_id=bpci-web-client
admin_user=admin
# admin_password stored in secrets vault

# =============================================================================
# [security] - Security Configuration
# =============================================================================
[security]
enable_token_validation=true
session_timeout_minutes=30
enable_auto_logout=true
enable_2fa=false
enable_audit_logging=true

# =============================================================================
# [monitoring] - Monitoring & Metrics
# =============================================================================
[monitoring]
enable_prometheus=true
prometheus_port=9091
enable_grafana=true
grafana_port=3000
metrics_interval_seconds=60

# =============================================================================
# [network] - Network Configuration
# =============================================================================
[network]
network_type=mainnet
enable_p2p_mesh=true
max_peers=50
enable_upnp=false

# =============================================================================
# [commute_lock] - Lock-Based Communication Configuration
# =============================================================================
[commute_lock]
enabled=true
communication_mode=shared_memory
lock_dir=/var/lock/bpci
shm_dir=/dev/shm/bpci
event_dir=/var/run/bpci

# Shared memory sizes per component (MB)
consensus_shm_mb=10
blockchain_shm_mb=20
auction_shm_mb=15
bso_k8_shm_mb=5
bridge_shm_mb=10
cluster_ledger_shm_mb=100
xtmp_shm_mb=10
shadow_registry_shm_mb=10
web_shm_mb=5

# BPI address data configuration
bpi_data_dir=/dev/shm/bpci/bpi_data
bpi_data_per_address_mb=1
max_bpi_addresses=1000000

# Lock configuration
lock_timeout_ms=1000
lock_retry_count=3
enable_lock_monitoring=true

# Event notification
event_buffer_size=1024
event_timeout_ms=100

# Performance tuning
zero_copy_enabled=true
lock_free_queues=true
numa_aware=true

# =============================================================================
# END OF CONFIGURATION
# =============================================================================
# This file will be parsed by env_ini_parser.rs
# Lock file (envtoml.lock) will be auto-generated
# All components will be deployed via BSO-K8 (no Docker, no Kubernetes)
