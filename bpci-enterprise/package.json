{
  "name": "bpci-enterprise-system",
  "version": "1.0.0",
  "description": "Complete BPCI Enterprise System with integrated website, admin dashboard, and HTTPCG protocol",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:website\" \"npm run dev:admin\" \"npm run dev:bpci\"",
    "dev:website": "cd website && npm run dev",
    "dev:admin": "cd admin-dashboard && npm run dev",
    "dev:bpci": "cd bpci-server && npm run dev",
    "build": "npm run build:website && npm run build:admin && npm run build:bpci",
    "build:website": "cd website && npm run build",
    "build:admin": "cd admin-dashboard && npm run build",
    "build:bpci": "cd bpci-server && npm run build",
    "start": "concurrently \"npm run start:website\" \"npm run start:admin\" \"npm run start:bpci\"",
    "start:website": "cd website && npm run start",
    "start:admin": "cd admin-dashboard && npm run start",
    "start:bpci": "cd bpci-server && npm run start",
    "test": "npm run test:website && npm run test:admin && npm run test:bpci",
    "test:website": "cd website && npm run test",
    "test:admin": "cd admin-dashboard && npm run test",
    "test:bpci": "cd bpci-server && npm run test",
    "deploy": "./scripts/deploy-bpci-enterprise.sh",
    "setup": "./scripts/setup-bpci-enterprise.sh"
  },
  "workspaces": [
    "website",
    "admin-dashboard",
    "bpci-server",
    "httpcg-wallet"
  ],
  "devDependencies": {
    "concurrently": "^8.2.2",
    "lerna": "^7.4.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "vercel": "^47.0.5",
    "ws": "^8.18.3"
  }
}
