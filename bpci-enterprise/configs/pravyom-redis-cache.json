{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "pravyom-redis-cache",
    "labels": {
      "app": "pravyom-enterprise",
      "tier": "cache",
      "component": "redis"
    }
  },
  "spec": {
    "type": "RedisCache",
    "port": 6379,
    "memory_limit": "256mb",
    "vpods": 4,
    "resources": {
      "memory_mb": 32,
      "cpu_cores": 0.5,
      "storage_gb": 1,
      "network_bandwidth": "500Mbps"
    },
    "config": {
      "maxmemory": "256mb",
      "maxmemory_policy": "allkeys-lru",
      "save": "900 1 300 10 60 10000",
      "appendonly": "yes",
      "bind": "0.0.0.0",
      "protected_mode": "no"
    },
    "health_check": {
      "command": "redis-cli ping",
      "interval": 30,
      "timeout": 5
    }
  }
}
