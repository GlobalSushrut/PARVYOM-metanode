{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "pravyom-nginx-loadbalancer",
    "labels": {
      "app": "pravyom-enterprise",
      "tier": "proxy",
      "component": "nginx"
    }
  },
  "spec": {
    "type": "NginxProxy",
    "config_path": "/tmp/pravyom_nginx_lb.conf",
    "upstream_services": [
      "localhost:8080",
      "localhost:3000"
    ],
    "vpods": 4,
    "resources": {
      "memory_mb": 24,
      "cpu_cores": 0.5,
      "storage_gb": 1,
      "network_bandwidth": "1Gbps"
    },
    "nginx_config": {
      "worker_processes": "auto",
      "worker_connections": 1024,
      "keepalive_timeout": 65,
      "client_max_body_size": "10M",
      "proxy_connect_timeout": "30s",
      "proxy_send_timeout": "30s",
      "proxy_read_timeout": "30s",
      "cors_enabled": true,
      "cors_origins": [
        "http://localhost:3000",
        "http://localhost:80",
        "http://146.190.74.139",
        "https://146.190.74.139"
      ]
    },
    "endpoints": [
      {
        "name": "frontend",
        "port": 80,
        "upstream": "localhost:3000",
        "path": "/"
      },
      {
        "name": "api",
        "port": 8080,
        "upstream": "localhost:8080",
        "path": "/api"
      },
      {
        "name": "health",
        "port": 80,
        "path": "/health"
      }
    ],
    "health_check": {
      "endpoint": "/health",
      "interval": 30,
      "timeout": 5
    }
  }
}
