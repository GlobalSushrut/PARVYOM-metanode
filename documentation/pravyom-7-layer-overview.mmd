graph LR
  %% Ultra-simplified 7-layer overview (30s mental model)
  %% Same color semantics as full diagram
  %%  - Grey  : Clients / external systems
  %%  - Teal  : Edge / API & settlement
  %%  - Green : BPCI Enterprise
  %%  - Blue  : BPI Core
  %%  - Purple: Hermes / Web4 Mesh
  %%  - Orange: Storage / evidence / analytics
  %%  - Gold  : Economics / governance / readiness / observability

  classDef client   fill:#f5f5f5,stroke:#9e9e9e,stroke-width:1px,color:#212121;
  classDef edge     fill:#e0f7fa,stroke:#00796b,stroke-width:1px,color:#004d40;
  classDef bpci     fill:#e8f5e9,stroke:#2e7d32,stroke-width:1px,color:#1b5e20;
  classDef bpi      fill:#e3f2fd,stroke:#1565c0,stroke-width:1px,color:#0d47a1;
  classDef hermes   fill:#f3e5f5,stroke:#6a1b9a,stroke-width:1px,color:#4a148c;
  classDef storage  fill:#fff3e0,stroke:#ef6c00,stroke-width:1px,color:#e65100;
  classDef gov      fill:#fffde7,stroke:#f9a825,stroke-width:1px,color:#f57f17;

  %% 1. Who uses it?
  C["1. Clients & External Systems\nWallets / dApps / Enterprise / IoT"]
  class C client;

  %% 2. Where do requests enter?
  E["2. Edge / API & Settlement\nGateways, HTTPCG, Payment Rails"]
  class E edge;

  %% 3. Enterprise brain on top of BPI
  BPCI["3. BPCI Enterprise Layer\nConsensus Server, Cluster Ledger, CUEDB, Economics, Readiness"]
  class BPCI bpci;

  %% 4. Core blockchain OS
  BPI["4. BPI Core Consensus & State\nLCCD, VO Kernel, Logbook/6D, QLock, Audit, Forensics"]
  class BPI bpi;

  %% 5. Self-healing P2P fabric
  H["5. Hermes / Web4 Mesh & Transport\nKappa Routing, W4-Fluid, QuantumHeartbeat"]
  class H hermes;

  %% 6. Evidence and data
  S["6. Storage, Evidence & Analytics\nIPFS++, ZipLock .zkl, CUEDB, Forensic Bundles"]
  class S storage;

  %% 7. Control plane
  G["7. Economics, Governance & Readiness\nFees & PoE, GeoDID/BISO, Readiness, Observability"]
  class G gov;

  %% High-level flows
  C --> E
  E --> BPCI
  BPCI --> BPI
  BPI --> H
  H --> BPI
  BPI --> S
  BPCI --> S
  S --> G
  BPI --> G
  BPCI --> G

  %% Short narrative (comments only)
  %%  - Clients send traffic to Edge/API.
  %%  - Edge normalizes into BPCI (enterprise brain).
  %%  - BPCI drives real consensus/state in BPI Core.
  %%  - Hermes mesh carries traffic around / between nodes.
  %%  - BPI/BPCI materialize evidence & data in Storage.
  %%  - Governance/Economics/Readiness read all metrics & evidence and tune the system back.
